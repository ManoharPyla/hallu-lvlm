# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/
.env
.env.*

# Data, downloaded datasets and extracted features
data/
*.npz
*.npy
*.h5
*.hdf5

# Model weights and checkpoints
weights/
checkpoints/
