experiments/runs/
experiments/results/*
!experiments/results/*.json
!experiments/results/*.csv
!experiments/results/*.md
!experiments/results/.gitkeep

# Logs and temporary files
*.log
.DS_Store
.ipynb_checkpoints/

# Generated LaTeX files
paper/*.aux
paper/*.out
paper/*.toc
paper/*.fls
paper/*.fdb_latexmk

# Local backup files
*.bak
.gitignore.backup
